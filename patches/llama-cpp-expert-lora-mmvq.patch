+// One block per selected expert slot. Writes h[slot, rank] = A[expert]^T x[slot].
+// Ranks are accumulated together so x is read once per tile instead of once per rank.
+template <int TILE>
+static __global__ void lora_expert_ax_kernel(
+        const void * A, const float * x, const int32_t * ids, float * h,
+        int K, int rank, int nchannels_y, int nb1_a, int nb2_a, int x_stride_channel, int f16) {
+    const int slot = blockIdx.x;
+    const int expert = ids[slot];
+    const int channel_y = nchannels_y > 1 ? slot % nchannels_y : 0;
+    const float * xv = x + channel_y * x_stride_channel;
+    const int tid = threadIdx.x;
+    const int nthreads = blockDim.x;
+    const int lane = tid & 31;
+    const int warp = tid >> 5;
+    const int nwarps = nthreads >> 5;
+
+    __shared__ float wsum[8][TILE];
+
+    for (int j0 = 0; j0 < rank; j0 += TILE) {
+        const int tile = rank - j0 < TILE ? rank - j0 : TILE;
+        float acc[TILE];
+#pragma unroll
+        for (int t = 0; t < TILE; ++t) {
+            acc[t] = 0.0f;
+        }
+
+        if (f16) {
+            const __half * A16 = reinterpret_cast<const __half *>(A);
+            const bool vec = ((reinterpret_cast<uintptr_t>(xv) & 15) == 0) && (K % 4 == 0);
+            if (vec) {
+                const int K4 = K >> 2;
+                const float4 * x4 = reinterpret_cast<const float4 *>(xv);
+                for (int k4 = tid; k4 < K4; k4 += nthreads) {
+                    const float4 v = x4[k4];
+                    const int k = k4 << 2;
+#pragma unroll
+                    for (int t = 0; t < TILE; ++t) {
+                        if (t < tile) {
+                            const __half * col = A16 + expert * nb2_a + (j0 + t) * nb1_a + k;
+                            acc[t] += v.x * __half2float(col[0]) + v.y * __half2float(col[1])
+                                    + v.z * __half2float(col[2]) + v.w * __half2float(col[3]);
+                        }
+                    }
+                }
+            } else {
+                for (int k = tid; k < K; k += nthreads) {
+                    const float xv_k = xv[k];
+#pragma unroll
+                    for (int t = 0; t < TILE; ++t) {
+                        if (t < tile) {
+                            acc[t] += xv_k * __half2float(A16[expert * nb2_a + (j0 + t) * nb1_a + k]);
+                        }
+                    }
+                }
+            }
+        } else {
+            const float * Af = reinterpret_cast<const float *>(A);
+            for (int k = tid; k < K; k += nthreads) {
+                const float xv_k = xv[k];
+#pragma unroll
+                for (int t = 0; t < TILE; ++t) {
+                    if (t < tile) {
+                        acc[t] += xv_k * Af[expert * nb2_a + (j0 + t) * nb1_a + k];
+                    }
+                }
+            }
+        }
+
+#pragma unroll
+        for (int t = 0; t < TILE; ++t) {
+            const float sum = warp_reduce_sum<32>(acc[t]);
+            if (lane == 0) {
+                wsum[warp][t] = sum;
+            }
+        }
+        __syncthreads();
+        if (warp == 0) {
+#pragma unroll
+            for (int t = 0; t < TILE; ++t) {
+                float sum = lane < nwarps ? wsum[lane][t] : 0.0f;
+                sum = warp_reduce_sum<32>(sum);
+                if (lane == 0 && t < tile) {
+                    h[slot * rank + j0 + t] = sum;
+                }
+            }
+        }
+        __syncthreads();
+    }
+}
+
+static __device__ float lora_delta_row(
+        const ggml_cuda_mm_fusion_args_device & fusion, const float * lora_h, int expert, int row) {
+    const int rank  = fusion.lora_rank;
+    const int b_idx = expert * fusion.lora_nb2_b + row * fusion.lora_nb1_b;
+    float delta = 0.0f;
+    if (fusion.lora_f16) {
+        const __half * b = reinterpret_cast<const __half *>(fusion.lora_b) + b_idx;
+        for (int j = 0; j < rank; ++j) {
+            delta += __half2float(b[j]) * lora_h[j];
+        }
+    } else {
+        const float * b = reinterpret_cast<const float *>(fusion.lora_b) + b_idx;
+        for (int j = 0; j < rank; ++j) {
+            delta += b[j] * lora_h[j];
+        }
+    }
+    return fusion.lora_scale * delta;
+}

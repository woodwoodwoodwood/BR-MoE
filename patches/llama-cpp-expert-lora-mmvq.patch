+            fusion.gate_lora_a, fusion.gate_lora_rank, fusion.gate_lora_nb1_a, fusion.gate_lora_nb2_a, fusion.gate_lora_f16,
+            n_slots, nchannels_y,
+            ne00, s01, s02, s03, ne0, (uint32_t) ne1, ne2_fastdiv);
+
+    const ggml_cuda_kernel_launch_params reduce_params = ggml_cuda_kernel_launch_params(dim3(1), dim3(256), 0, stream);
+    if (h_up) {
+        ggml_cuda_kernel_launch(lora_reduce_partials, reduce_params,

+struct cuda_expert_proj {
+    int n = 0;
+    ggml_tensor * mm = nullptr;
+    ggml_tensor * out = nullptr;
+    const ggml_tensor * A = nullptr;
+    const ggml_tensor * B = nullptr;
+    float scale = 1.0f;

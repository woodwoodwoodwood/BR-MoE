+static bool cuda_decode_expert_proj(const ggml_cgraph * cgraph, int i, cuda_expert_proj & p) {
+    if (i >= cgraph->n_nodes) {
+        return false;
+    }
+    ggml_tensor * mm = cgraph->nodes[i];
+    if (mm->op != GGML_OP_MUL_MAT_ID) {
+        return false;
+    }
+    if (i + 4 < cgraph->n_nodes) {
+        ggml_tensor * mm_a = cgraph->nodes[i + 1];
+        ggml_tensor * mm_b = cgraph->nodes[i + 2];
+        ggml_tensor * sc   = cgraph->nodes[i + 3];
+        ggml_tensor * add  = cgraph->nodes[i + 4];
+        if (mm_a->op == GGML_OP_MUL_MAT_ID && mm_b->op == GGML_OP_MUL_MAT_ID &&
+                sc->op == GGML_OP_SCALE && add->op == GGML_OP_ADD) {
+            const ggml_tensor * A = mm_a->src[0];
+            const ggml_tensor * B = mm_b->src[0];
+            const ggml_tensor * W = mm->src[0];
+            const bool edges =
+                mm_a->src[1] == mm->src[1] && mm_a->src[2] == mm->src[2] &&
+                mm_b->src[1] == mm_a && mm_b->src[2] == mm->src[2] &&
+                sc->src[0] == mm_b &&
+                ((add->src[0] == mm && add->src[1] == sc) || (add->src[1] == mm && add->src[0] == sc));
+            const bool shapes = A && B && W &&
+                (A->type == GGML_TYPE_F16 || A->type == GGML_TYPE_F32) && B->type == A->type &&
+                A->nb[0] == ggml_type_size(A->type) && B->nb[0] == ggml_type_size(B->type) &&
+                A->ne[0] == W->ne[0] && A->ne[2] == W->ne[2] &&
+                B->ne[1] == W->ne[1] && B->ne[2] == W->ne[2] &&
+                A->ne[1] == B->ne[0] && A->ne[1] > 0 && A->ne[1] <= GGML_CUDA_LORA_MAX_RANK &&
+                ggml_get_op_params_f32(sc, 1) == 0.0f;
+            if (edges && shapes) {
+                p.n = 5;
+                p.mm = mm;
+                p.out = add;
+                p.A = A;
+                p.B = B;
+                p.scale = ggml_get_op_params_f32(sc, 0);
+                return true;
+            }
+        }
+    }
+    p.n = 1;
+    p.mm = mm;
+    p.out = mm;
+    p.A = nullptr;
+    p.B = nullptr;
+    p.scale = 1.0f;
+    return true;
+}

+static __global__ void quantize_q8_1_lora(
+        const float * x_ptr, void * vy_ptr, const int32_t * ids,
+        float * partial_up, float * partial_gate,
+        const void * A_up, int rank_up, int nb1_up, int nb2_up, int f16_up,
+        const void * A_gate, int rank_gate, int nb1_gate, int nb2_gate, int f16_gate,
+        int n_slots, int nchannels_y,
+        const int64_t ne00, const int64_t s01, const int64_t s02, const int64_t s03,
+        const int64_t ne0, const uint32_t ne1, const uint3 ne2) {
+    const float * GGML_CUDA_RESTRICT x  = x_ptr;
+    void        * GGML_CUDA_RESTRICT vy = vy_ptr;
+    const int64_t i0 = (int64_t) blockDim.x * blockIdx.x + threadIdx.x;
+
+    const int64_t i3 = fastdiv(blockIdx.z, ne2);
+    const int64_t i2 = blockIdx.z - i3*ne2.z;
+    const int64_t i1 = blockIdx.y;
+
+    float xi = 0.0f;
+    if (i0 < ne0) {
+        const int64_t i00 = i0;
+        const int64_t i_cont = ((i3*ne2.z + i2) * ne1 + i1) * ne0 + i0;
+
+        block_q8_1 * y = (block_q8_1 *) vy;
+        const int64_t ib  = i_cont / QK8_1;
+        const int64_t iqs = i_cont % QK8_1;
+
+        xi = i0 < ne00 ? x[i3*s03 + i2*s02 + i1*s01 + i00] : 0.0f;
+        float amax = fabsf(xi);
+        float sum  = xi;
+
+        amax = warp_reduce_max<QK8_1>(amax);
+        sum  = warp_reduce_sum<QK8_1>(sum);
+
+        const float  d = amax / 127.0f;
+        const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+
+        y[ib].qs[iqs] = q;
+        if (iqs == 0) {
+            y[ib].ds = make_half2(d, sum);
+        }
+    }
+
+    if (blockIdx.z != 0) {
+        return;
+    }
+
+    lora_accum_partials(xi, (int) i0, (int) ne00, (int) i1, nchannels_y, n_slots, ids,
+            A_up, partial_up, rank_up, nb1_up, nb2_up, f16_up);
+    lora_accum_partials(xi, (int) i0, (int) ne00, (int) i1, nchannels_y, n_slots, ids,
+            A_gate, partial_gate, rank_gate, nb1_gate, nb2_gate, f16_gate);
+}
+
+static __global__ void lora_reduce_partials(const float * partial, float * h, int n_k_blocks, int n_slots, int rank) {
+    const int n = n_slots * rank;
+    for (int idx = (int) threadIdx.x; idx < n; idx += (int) blockDim.x) {
+        const int slot = idx / rank;
+        const int j    = idx - slot * rank;
+        float sum = 0.0f;
+        for (int kb = 0; kb < n_k_blocks; ++kb) {
+            sum += partial[((int64_t) kb * n_slots + slot) * rank + j];
+        }
+        h[idx] = sum;
+    }
+}

 // One reduction of TILE ranks. Channel mismatches are block-uniform, so the
 // slot skip does not diverge __syncthreads. Partials stay deterministic.
+template <bool F16, int TILE>
+static __device__ void lora_accum_tile(
+        float xi, int i0, int ne00, int slot, int expert, int j0,
+        const void * A, float * partial, int rank, int nb1, int nb2,
+        int n_slots, int kb, float (*wsum)[TILE]) {
+    const int tid  = threadIdx.x;
+    const int lane = tid & 31;
+    const int warp = tid >> 5;
+    const int nwarps = blockDim.x >> 5;
+    float acc[TILE];
+#pragma unroll
+    for (int t = 0; t < TILE; ++t) {
+        acc[t] = 0.0f;
+    }
+    if (i0 < ne00) {
+        const int ebase = expert * nb2 + i0;
+        if constexpr (F16) {
+            const __half * a = reinterpret_cast<const __half *>(A);
+#pragma unroll
+            for (int t = 0; t < TILE; ++t) {
+                acc[t] = xi * __half2float(__ldg(a + ebase + (j0 + t) * nb1));
+            }
+        } else {
+            const float * a = reinterpret_cast<const float *>(A);
+#pragma unroll
+            for (int t = 0; t < TILE; ++t) {
+                acc[t] = xi * __ldg(a + ebase + (j0 + t) * nb1);
+            }
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < TILE; ++t) {
+        const float s = warp_reduce_sum<32>(acc[t]);
+        if (lane == 0) {
+            wsum[warp][t] = s;
+        }
+    }
+    __syncthreads();
+    if (warp == 0) {
+#pragma unroll
+        for (int t = 0; t < TILE; ++t) {
+            float s = lane < nwarps ? wsum[lane][t] : 0.0f;
+            s = warp_reduce_sum<32>(s);
+            if (lane == 0) {
+                partial[((int64_t) kb * n_slots + slot) * rank + j0 + t] = s;
+            }
+        }
+    }
+    __syncthreads();
+}
+
+static __device__ void lora_accum_partials(
+        float xi, int i0, int ne00, int channel, int nchannels_y, int n_slots,
+        const int32_t * ids, const void * A, float * partial, int rank, int nb1, int nb2, int f16) {
+    if (A == nullptr || partial == nullptr || rank <= 0) {
+        return;
+    }
+    __shared__ float wsum16[8][16];
+    __shared__ float wsum1[8][1];
+    const int kb = (int) blockIdx.x;
+    for (int slot = 0; slot < n_slots; ++slot) {
+        if (channel != slot % nchannels_y) {
+            continue;
+        }
+        const int expert = ids[slot];
+        int j0 = 0;
+        if (f16) {
+            for (; j0 + 16 <= rank; j0 += 16) {
+                lora_accum_tile<true, 16>(xi, i0, ne00, slot, expert, j0, A, partial, rank, nb1, nb2, n_slots, kb, wsum16);
+            }
+            for (; j0 < rank; ++j0) {
+                lora_accum_tile<true, 1>(xi, i0, ne00, slot, expert, j0, A, partial, rank, nb1, nb2, n_slots, kb, wsum1);
+            }
+        } else {
+            for (; j0 + 16 <= rank; j0 += 16) {
+                lora_accum_tile<false, 16>(xi, i0, ne00, slot, expert, j0, A, partial, rank, nb1, nb2, n_slots, kb, wsum16);
+            }
+            for (; j0 < rank; ++j0) {
+                lora_accum_tile<false, 1>(xi, i0, ne00, slot, expert, j0, A, partial, rank, nb1, nb2, n_slots, kb, wsum1);
+            }
+        }
+    }
+}

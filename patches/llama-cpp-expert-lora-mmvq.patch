+// Gate is expanded before up (SwiGLU src0), but either order is accepted.
+// If either lane has a LoRA chain, fold both GEMVs, the LoRA epilogues, and
+// SwiGLU into one mul_mat_vec_q. Plain gate+up stays on the existing path.
+static int ggml_cuda_try_fuse_expert_lora_glu(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
+    cuda_expert_proj first, second;
+    if (!cuda_decode_expert_proj(cgraph, i, first)) {
+        return 0;
+    }
+    if (!cuda_decode_expert_proj(cgraph, i + first.n, second)) {
+        return 0;
+    }
+    if (first.A == nullptr && second.A == nullptr) {
+        return 0;
+    }
+    const int n = first.n + second.n + 1;
+    if (i + n - 1 >= cgraph->n_nodes) {
+        return 0;
+    }
+    ggml_tensor * glu = cgraph->nodes[i + first.n + second.n];
+    if (glu->op != GGML_OP_GLU) {
+        return 0;
+    }
+    cuda_expert_proj * gate = nullptr;
+    cuda_expert_proj * up = nullptr;
+    if (glu->src[0] == first.out && glu->src[1] == second.out) {
+        gate = &first;
+        up = &second;
+    } else if (glu->src[0] == second.out && glu->src[1] == first.out) {
+        gate = &second;
+        up = &first;
+    } else {
+        return 0;
+    }
+    if (ggml_get_op_params_i32(glu, 1) != 0) {
+        return 0;
+    }
+    const ggml_tensor * up_w = up->mm->src[0];
+    const ggml_tensor * gate_w = gate->mm->src[0];
+    if (up_w->type != gate_w->type || !ggml_are_same_shape(up_w, gate_w) || !ggml_are_same_stride(up_w, gate_w)) {
+        return 0;
+    }
+    if (up->mm->src[1] != gate->mm->src[1] || up->mm->src[2] != gate->mm->src[2]) {
+        return 0;
+    }
+    if (up->mm->ne[2] != 1 || gate->mm->ne[2] != 1 || !ggml_cuda_should_fuse_mul_mat_vec_q(up->mm)) {
+        return 0;
+    }
+
+    static constexpr std::array<ggml_glu_op, 4> valid_glu_ops = {
+        GGML_GLU_OP_SWIGLU, GGML_GLU_OP_GEGLU, GGML_GLU_OP_SWIGLU_OAI, GGML_GLU_OP_SWIGLU_CLAMP };
+    if (std::find(valid_glu_ops.begin(), valid_glu_ops.end(), ggml_get_glu_op(glu)) == valid_glu_ops.end()) {
+        return 0;
+    }
+
+    ggml_op ops[12];
+    int nop = 0;
+    auto push = [&](const cuda_expert_proj & p) {
+        if (p.n == 5) {
+            ops[nop++] = GGML_OP_MUL_MAT_ID;
+            ops[nop++] = GGML_OP_MUL_MAT_ID;
+            ops[nop++] = GGML_OP_MUL_MAT_ID;
+            ops[nop++] = GGML_OP_SCALE;
+            ops[nop++] = GGML_OP_ADD;
+        } else {
+            ops[nop++] = GGML_OP_MUL_MAT_ID;
+        }
+    };
+    push(first);
+    push(second);
+    ops[nop++] = GGML_OP_GLU;
+    const int out_nodes[] = { i + nop - 1 };
+    if (!ggml_can_fuse_subgraph(cgraph, i, nop, ops, out_nodes, 1) ||
+            !ggml_cuda_check_fusion_memory_ranges(cgraph, i, nop, out_nodes, 1)) {
+        return 0;
+    }
+
+    ggml_cuda_mm_fusion_args_host fusion_data{};
+    fusion_data.gate      = gate_w;
+    fusion_data.glu_op    = ggml_get_glu_op(glu);
+    fusion_data.glu_limit = ggml_get_op_params_f32(glu, 3);
+    if (up->A) {
+        fusion_data.lora_a     = up->A;
+        fusion_data.lora_b     = up->B;
+        fusion_data.lora_scale = up->scale;
+    }
+    if (gate->A) {
+        fusion_data.gate_lora_a     = gate->A;
+        fusion_data.gate_lora_b     = gate->B;
+        fusion_data.gate_lora_scale = gate->scale;
+    }
+    ggml_cuda_mul_mat_vec_q(*cuda_ctx, up_w, up->mm->src[1], up->mm->src[2], glu, &fusion_data);
+    return nop - 1;
+}
